# Copy to .env and add your OpenRouter key. Never commit .env.
OPENROUTER_API_KEY=
# Optional: any OpenRouter model id
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# IDO Group Finance sign-in (checked on the server: locally by Vite, on Vercel by api/login)
IDO_USERNAME=
IDO_PASSWORD=
# Optional: fixed key for signing IDO sessions (any long random string).
# If unset, it is derived from the IDO credentials, so changing the password signs everyone out.
AUTH_SECRET=
